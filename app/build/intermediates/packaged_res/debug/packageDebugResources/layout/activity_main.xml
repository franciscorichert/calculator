<?xml version="1.0" encoding="utf-8"?>
                                                                   

    
                 
                        
                            
           

    <LinearLayout
        android:id="@+id/raiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/morado"
        android:orientation="vertical" android:tag="layout/activity_main_0" xmlns:android="http://schemas.android.com/apk/res/android">

        <LinearLayout
            android:id="@+id/contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/fondo"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/pantalla"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="binding_1"       
                    android:textColor="@color/texto"
                    android:textSize="48sp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/black" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/linea" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/boton1"
                        style="@style/BotonCalculadora"
                        android:text="1" />

                    <TextView
                        android:id="@+id/boton2"
                        style="@style/BotonCalculadora"
                        android:text="2" />

                    <TextView
                        android:id="@+id/boton3"
                        style="@style/BotonCalculadora"
                        android:text="3" />

                    <TextView
                        android:id="@+id/botonDividir"
                        style="@style/BotonCalculadora"
                        android:text="/" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/boton4"
                        style="@style/BotonCalculadora"
                        android:text="4" />

                    <TextView
                        android:id="@+id/boton5"
                        style="@style/BotonCalculadora"
                        android:text="5" />

                    <TextView
                        android:id="@+id/boton6"
                        style="@style/BotonCalculadora"
                        android:text="6" />

                    <TextView
                        android:id="@+id/botonMultiplicar"
                        style="@style/BotonCalculadora"
                        android:text="*" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/boton7"
                        style="@style/BotonCalculadora"
                        android:text="7" />

                    <TextView
                        android:id="@+id/boton8"
                        style="@style/BotonCalculadora"
                        android:text="8" />

                    <TextView
                        android:id="@+id/boton9"
                        style="@style/BotonCalculadora"
                        android:text="9" />

                    <TextView
                        android:id="@+id/botonRestar"
                        style="@style/BotonCalculadora"
                        android:text="-" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/boton0"
                        style="@style/BotonCalculadora"
                        android:text="0" />

                    <TextView
                        android:id="@+id/botonPunto"
                        style="@style/BotonCalculadora"
                        android:text="." />

                    <TextView
                        android:id="@+id/botonIgual"
                        style="@style/BotonCalculadora"
                        android:text="=" />

                    <TextView
                        android:id="@+id/botonSumar"
                        style="@style/BotonCalculadora"
                        android:text="+" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
         